# Build output (build_exe.bat writes to ../build and ../dist, outside the repo)
__pycache__/
*.pyc
build/
dist/

# Safety net: user data never belongs in the repo.
# The app keeps it in ../Data, outside this folder (index, config, log).
Data/
*.db
*.db-wal
*.db-shm
config.json
*.log

# IDE / virtual environments
.idea/
.vscode/
.venv/
venv/
